// P0 骨架：仅定义数据源与基础模型，不包含任何业务种子数据。
// 真实迁移在后续迭代生成；本文件保证 prisma generate 可用。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestDriveLead {
  id        String   @id @default(uuid())
  vehicle   String
  name      String
  phone     String
  storeId   String?
  createdAt DateTime @default(now())
}

model Store {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String
  createdAt DateTime @default(now())
}

model NewsArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}
